<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="stock_picking_form_inherit_payment_workflow" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.payment.workflow</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>

        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">
                <group string="Informations de livraison">
                    <field name="delivery_note"/>
                </group>
            </xpath>

        </field>

    </record>

</odoo>